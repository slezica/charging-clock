#!/usr/bin/env python3
"""Charging Clock project toolkit. Run `bin/chclock help` for usage."""

import argparse
import datetime
import getpass
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DIST = ROOT / "dist"
BUILD_LOG = DIST / "build.log"
GRADLE_FILE = ROOT / "app" / "build.gradle"
VERSIONS_FILE = ROOT / "docs" / "VERSIONS.md"
KEYSTORE = ROOT / "secrets" / "release.keystore"
KEY_ALIAS = "chclock"
ICON_SVG = ROOT / "art" / "icon.svg"
AOD_SVG = ROOT / "art" / "aod-lockscreen.svg"

APP_ID = "io.salezica.chclock"
DEBUG_APP_ID = APP_ID + ".debug"
MAIN_ACTIVITY = APP_ID + ".MainActivity"
AOD_PACKAGE = "com.samsung.android.app.aodservice"

# Must match MockMainPresenter.PRESETS:
STATES = [
    "perfect", "unplugged", "no-permission", "wrong-style",
    "battery-restricted", "not-supported", "disabled", "all-warnings",
]


def die(message):
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def run(cmd, env=None, capture=False, cwd=ROOT):
    return subprocess.run(
        cmd, cwd=cwd, env=env, text=True,
        capture_output=capture, check=False,
    )


# ---------------------------------------------------------------- gradle

def gradle(tasks, env=None):
    """Run gradle tasks, teeing output to dist/build.log. Returns True on success."""
    DIST.mkdir(exist_ok=True)
    full_env = dict(os.environ, **(env or {}))

    with open(BUILD_LOG, "w") as log:
        process = subprocess.Popen(
            [str(ROOT / "gradlew")] + tasks, cwd=ROOT, env=full_env,
            stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True,
        )
        for line in process.stdout:
            log.write(line)
        process.wait()

    return process.returncode == 0


def print_build_failure():
    print("\nBuild failed. Last lines of the log:\n", file=sys.stderr)
    lines = BUILD_LOG.read_text().splitlines()
    for line in lines[-40:]:
        print(f"  {line}", file=sys.stderr)
    print(f"\nFull log: {BUILD_LOG}", file=sys.stderr)


def read_version():
    match = re.search(r'versionName\s+"([^"]+)"', GRADLE_FILE.read_text())
    if not match:
        die(f"versionName not found in {GRADLE_FILE}")
    return match.group(1)


# ------------------------------------------------------------------- adb

def find_adb():
    adb = shutil.which("adb")
    if adb:
        return adb

    local_props = ROOT / "local.properties"
    if local_props.exists():
        match = re.search(r"sdk\.dir=(.+)", local_props.read_text())
        if match:
            candidate = Path(match.group(1).strip()) / "platform-tools" / "adb"
            if candidate.exists():
                return str(candidate)

    return None


def adb_env_candidates():
    """Environments to try: local adb server, then the host's (from a container)."""
    yield dict(os.environ)
    yield dict(os.environ, ADB_SERVER_SOCKET="tcp:host.docker.internal:5037")


def connect_adb():
    """Return (adb_path, env) with a device attached, or die with instructions."""
    adb = find_adb()
    if not adb:
        die("adb not found (PATH or local.properties sdk.dir)")

    for env in adb_env_candidates():
        result = run([adb, "devices"], env=env, capture=True)
        if result.returncode != 0:
            continue
        devices = [
            line for line in result.stdout.splitlines()[1:]
            if line.strip() and "\tdevice" in line
        ]
        if devices:
            return adb, env

    die(
        "no adb device found.\n"
        "  - Connect a device or start an emulator on the host.\n"
        "  - From the container, the host adb server must be reachable\n"
        "    (adb -a nodaemon server, or `adb start-server` with\n"
        "    ADB_SERVER_SOCKET exposed on tcp:5037)."
    )


# ------------------------------------------------------------ cmd: build

def cmd_build(args):
    version = read_version()
    variant = args.variant

    tasks = {"debug": ["assembleDebug"], "release": ["assembleRelease", "bundleRelease"]}[variant]

    if variant == "release" and "KEYSTORE_PASSWORD" not in os.environ:
        print("warning: KEYSTORE_PASSWORD not set; release build will be UNSIGNED")

    print(f"Building {variant} v{version} ...")
    if not gradle(tasks):
        print_build_failure()
        sys.exit(1)

    DIST.mkdir(exist_ok=True)
    artifacts = []

    apk_src = ROOT / f"app/build/outputs/apk/{variant}/app-{variant}.apk"
    if not apk_src.exists():
        # Unsigned release APKs get a different file name:
        apk_src = ROOT / f"app/build/outputs/apk/{variant}/app-{variant}-unsigned.apk"
    apk_dst = DIST / f"chclock-{variant}-{version}.apk"
    shutil.copy(apk_src, apk_dst)
    artifacts.append(apk_dst)

    if variant == "release":
        aab_src = ROOT / "app/build/outputs/bundle/release/app-release.aab"
        aab_dst = DIST / f"chclock-release-{version}.aab"
        shutil.copy(aab_src, aab_dst)
        artifacts.append(aab_dst)

    print("Build OK:")
    for artifact in artifacts:
        print(f"  {artifact.relative_to(ROOT)}")

    if args.install:
        adb, env = connect_adb()
        apk = next(a for a in artifacts if a.suffix == ".apk")
        app_id = DEBUG_APP_ID if variant == "debug" else APP_ID
        print(f"Installing {apk.name} ...")
        result = run([adb, "install", "-r", str(apk)], env=env, capture=True)
        if result.returncode != 0 and "INSTALL_FAILED_UPDATE_INCOMPATIBLE" in result.stdout + result.stderr:
            print("Signature mismatch with installed app; uninstalling and retrying ...")
            run([adb, "uninstall", app_id], env=env, capture=True)
            result = run([adb, "install", str(apk)], env=env, capture=True)
        if result.returncode != 0:
            die(f"adb install failed:\n{(result.stdout + result.stderr).strip()}")
        print("Installed.")

    return artifacts


# ---------------------------------------------------------- cmd: capture

def cmd_capture(args):
    if args.state and args.state not in STATES:
        die(f"unknown state '{args.state}'. Known: {', '.join(STATES)}")
    states = [args.state] if args.state else STATES

    adb, env = connect_adb()

    print("Building and installing debug APK ...")
    build_args = argparse.Namespace(variant="debug", install=True)
    cmd_build(build_args)

    shots_dir = DIST / "screenshots"
    shots_dir.mkdir(parents=True, exist_ok=True)

    def shell(*cmd):
        return run([adb, "shell"] + list(cmd), env=env, capture=True)

    def wait_for_activity(timeout_seconds=15):
        """Poll until MainActivity is the top resumed activity (cold starts can
        exceed any fixed sleep), then leave a beat for the final render."""
        for _ in range(timeout_seconds * 2):
            out = shell("dumpsys", "activity", "activities").stdout
            resumed = [line for line in out.splitlines() if "topResumedActivity" in line]
            if any(DEBUG_APP_ID in line for line in resumed):
                shell("sleep", "0.5")
                return
            shell("sleep", "0.5")
        die("MainActivity did not reach the foreground (crash? check logcat)")

    shell("input", "keyevent", "KEYCODE_WAKEUP")
    shell("wm", "dismiss-keyguard")

    for state in states:
        print(f"Capturing '{state}' ...")
        shell("am", "force-stop", DEBUG_APP_ID)
        shell(
            "am", "start", "-n", f"{DEBUG_APP_ID}/{MAIN_ACTIVITY}",
            "--es", "preset", state,
        )
        wait_for_activity()

        png = shots_dir / f"{state}.png"
        with open(png, "wb") as out:
            result = subprocess.run(
                [adb, "exec-out", "screencap", "-p"],
                env=env, stdout=out, check=False,
            )
        if result.returncode != 0 or png.stat().st_size == 0:
            die(f"screencap failed for state '{state}'")
        print(f"  {png.relative_to(ROOT)}")

    render_lockscreen()

    print("Capture OK.")


# ------------------------------------------------------------ cmd: probe

def cmd_probe(args):
    """Read-only device inspection: AOD settings entry points for the Fix action."""
    adb, env = connect_adb()

    def shell(*cmd):
        return run([adb, "shell"] + list(cmd), env=env, capture=True).stdout

    print(f"== {AOD_PACKAGE} installed? ==")
    installed = shell("pm", "list", "packages", AOD_PACKAGE).strip()
    print(f"  {installed or '(not installed — not a One UI device?)'}")

    print(f"\n== {AOD_PACKAGE} components in resolver tables ==")
    print("  (intent-filtered only; app enumerates ALL activities at runtime)")
    dump = shell("dumpsys", "package", AOD_PACKAGE)
    components = sorted(set(re.findall(re.escape(AOD_PACKAGE) + r"/\S+", dump)))
    for component in components:
        print(f"  {component}")
    if not components:
        print("  (none)")

    print("\n== android.settings.LOCK_SCREEN_SETTINGS resolves to ==")
    resolved = shell(
        "cmd", "package", "resolve-activity", "--brief",
        "-a", "android.settings.LOCK_SCREEN_SETTINGS",
    ).strip()
    print(f"  {resolved or '(nothing)'}")


# ---------------------------------------------------------- cmd: prepare

def preflight(args):
    failures = []

    if not sys.stdin.isatty():
        failures.append("not an interactive shell (password prompt needs a tty); run on the host")
    if not KEYSTORE.exists():
        failures.append(f"keystore not found at {KEYSTORE.relative_to(ROOT)}")
    if not shutil.which("keytool"):
        failures.append("keytool not found (JDK required)")
    if not shutil.which("git"):
        failures.append("git not found")
    if not shutil.which("rsvg-convert"):
        failures.append("rsvg-convert not found (brew install librsvg / apt install librsvg2-bin)")

    status = run(["git", "status", "--porcelain"], capture=True)
    if status.stdout.strip():
        failures.append("git working tree not clean; commit or stash first")

    if args.screenshots:
        adb = find_adb()
        if not adb:
            failures.append("adb not found (needed for --screenshots)")

    if failures:
        print("Pre-flight failed:", file=sys.stderr)
        for failure in failures:
            print(f"  - {failure}", file=sys.stderr)
        sys.exit(1)


def validate_password(password):
    env = dict(os.environ, KEYSTORE_PASSWORD=password)
    result = run(
        ["keytool", "-list", "-keystore", str(KEYSTORE),
         "-storepass:env", "KEYSTORE_PASSWORD", "-alias", KEY_ALIAS],
        env=env, capture=True,
    )
    if result.returncode != 0:
        die(f"keystore validation failed (bad password, or alias '{KEY_ALIAS}' missing):\n{result.stderr.strip()}")


def set_versions(version):
    x, y, z = (int(part) for part in version.split("."))
    if y > 99 or z > 99:
        die("minor/patch must be <= 99 (versionCode scheme X*10000 + Y*100 + Z)")
    version_code = x * 10000 + y * 100 + z

    content = GRADLE_FILE.read_text()
    content = re.sub(r"versionCode\s+\d+", f"versionCode {version_code}", content)
    content = re.sub(r'versionName\s+"[^"]+"', f'versionName "{version}"', content)
    GRADLE_FILE.write_text(content)
    print(f"Version set: {version} (versionCode {version_code})")


def prepend_changelog(version, changes):
    today = datetime.date.today().isoformat()
    entry = f"## {version} — {today}\n\n{changes.strip()}\n"

    if VERSIONS_FILE.exists():
        existing = VERSIONS_FILE.read_text()
        match = re.search(r"^## ", existing, re.MULTILINE)
        if match:
            existing = existing[:match.start()] + entry + "\n" + existing[match.start():]
        else:
            existing = existing.rstrip() + "\n\n" + entry
        VERSIONS_FILE.write_text(existing)
    else:
        VERSIONS_FILE.write_text(f"# Versions\n\n{entry}")
    print(f"Changelog updated: {VERSIONS_FILE.relative_to(ROOT)}")


def render_svg(svg, png, width, height):
    if not shutil.which("rsvg-convert"):
        die("rsvg-convert not found (brew install librsvg / apt install librsvg2-bin)")
    png.parent.mkdir(parents=True, exist_ok=True)
    result = run(
        ["rsvg-convert", "-w", str(width), "-h", str(height), str(svg), "-o", str(png)],
        capture=True,
    )
    if result.returncode != 0:
        die(f"render failed for {svg.name}:\n{result.stderr.strip()}")
    print(f"Rendered: {png.relative_to(ROOT)}")


def render_icon():
    render_svg(ICON_SVG, DIST / "icon-512.png", 512, 512)


def render_lockscreen():
    # Static fake of the AOD lock screen for the store listing; a real
    # screenshot can't be taken while the device is locked.
    render_svg(AOD_SVG, DIST / "screenshots" / "lockscreen.png", 1080, 2400)


def cmd_prepare(args):
    if not re.fullmatch(r"\d+\.\d+\.\d+", args.version):
        die("--version must be X.Y.Z")

    preflight(args)

    password = getpass.getpass(f"Keystore password for {KEYSTORE.relative_to(ROOT)}: ")
    validate_password(password)
    print("Keystore OK.")

    set_versions(args.version)
    prepend_changelog(args.version, args.changes)
    render_icon()

    print("Building signed release ...")
    os.environ["KEYSTORE_PASSWORD"] = password
    try:
        build_args = argparse.Namespace(variant="release", install=False)
        cmd_build(build_args)

        if args.screenshots:
            cmd_capture(argparse.Namespace(state=None))
    except SystemExit:
        print("\nRelease preparation FAILED. Tree left dirty for inspection.", file=sys.stderr)
        raise
    finally:
        del os.environ["KEYSTORE_PASSWORD"]

    tag = f"v{args.version}"
    run(["git", "add", str(GRADLE_FILE), str(VERSIONS_FILE)])
    if run(["git", "commit", "-m", f"Release {tag}"]).returncode != 0:
        die("git commit failed")
    if run(["git", "tag", tag]).returncode != 0:
        die("git tag failed")

    print(f"\nRelease {tag} prepared: committed, tagged, artifacts in dist/.")
    print("Upload the .aab in the Play Console, screenshots from dist/screenshots.")


# ------------------------------------------------------------- cmd: serve

def cmd_serve(args):
    import http.server

    web = ROOT / "web"
    if not web.is_dir():
        die(f"web directory not found at {web.relative_to(ROOT)}")

    handler = lambda *a, **kw: http.server.SimpleHTTPRequestHandler(*a, directory=str(web), **kw)
    with http.server.ThreadingHTTPServer(("", args.port), handler) as server:
        print(f"Serving {web.relative_to(ROOT)}/ at http://localhost:{args.port} (Ctrl-C to stop)")
        try:
            server.serve_forever()
        except KeyboardInterrupt:
            print("\nStopped.")


# ------------------------------------------------------------------ main

def main():
    parser = argparse.ArgumentParser(
        prog="chclock", description="Charging Clock project toolkit",
    )
    sub = parser.add_subparsers(dest="command")

    p_build = sub.add_parser("build", help="Build APK (and AAB for release) into dist/")
    p_build.add_argument("--variant", choices=["debug", "release"], default="debug")
    p_build.add_argument("--install", action="store_true", help="adb install after build")

    p_capture = sub.add_parser("capture", help="Screenshot mocked UI states via adb")
    p_capture.add_argument("state", nargs="?", help=f"one of: {', '.join(STATES)} (default: all)")

    sub.add_parser("probe", help="Inspect connected device for AOD settings entry points")

    p_prepare = sub.add_parser("prepare", help="Prepare a release (host only: prompts for keystore password)")
    p_prepare.add_argument("--version", required=True, help="X.Y.Z")
    p_prepare.add_argument("--changes", required=True, help="markdown changelog entry (multiline OK)")
    p_prepare.add_argument("--screenshots", action="store_true", help="also capture screenshots")

    p_serve = sub.add_parser("serve", help="Serve web/ locally")
    p_serve.add_argument("--port", type=int, default=8080)

    sub.add_parser("help", help="Show this help")

    args = parser.parse_args()

    if args.command in (None, "help"):
        parser.print_help()
        return

    {"build": cmd_build, "capture": cmd_capture, "probe": cmd_probe,
     "prepare": cmd_prepare, "serve": cmd_serve}[args.command](args)


if __name__ == "__main__":
    main()
